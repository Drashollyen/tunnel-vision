#!/bin/sh
# Not "env bash": under GitHub Desktop that can pick WSL's bash, which has no Git LFS or dotnet.
# Installed by scripts/setup. Runs the same quick checks as CI before each commit, and fixes
# C# whitespace in the files being committed.
set -euo pipefail

branch=$(git symbolic-ref --short HEAD 2>/dev/null || echo "")
if [[ "$branch" == "main" || "$branch" == "revamp" ]]; then
  echo "✖ Don't commit on $branch. Create your own branch first. See CONTRIBUTING.md."
  exit 1
fi

sh .github/scripts/check-meta.sh

to_fix=()
partly_staged=()
while IFS= read -r file; do
  [[ -z "$file" ]] && continue
  if git diff --quiet -- "$file"; then
    to_fix+=("$file")
  else
    partly_staged+=("$file")
  fi
done <<< "$(git diff --cached --name-only --diff-filter=ACMR -- 'Assets/_Project/*.cs')"

if [[ ${#to_fix[@]} -eq 0 && ${#partly_staged[@]} -eq 0 ]]; then
  exit 0
fi

if ! command -v dotnet >/dev/null 2>&1; then
  echo "⚠ .NET SDK not found, so C# whitespace wasn't fixed and CI may fail. Install it: see README.md > Setup."
  exit 0
fi

if [[ ${#to_fix[@]} -gt 0 ]]; then
  # --include paths are relative to the folder being formatted.
  if dotnet format whitespace Assets/_Project --folder --include "${to_fix[@]#Assets/_Project/}" >/dev/null 2>&1; then
    git add -- "${to_fix[@]}"
  else
    echo "⚠ Couldn't fix C# whitespace, so CI may fail."
  fi
fi

for file in ${partly_staged[@]+"${partly_staged[@]}"}; do
  echo "⚠ $file has changes you didn't select, so its whitespace wasn't fixed. Commit the whole file if CI fails."
done
