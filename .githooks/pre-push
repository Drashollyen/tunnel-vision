#!/bin/sh
# Not "env bash": under GitHub Desktop that can pick WSL's bash, which has no Git LFS or dotnet.
# Installed by scripts/setup. Stops direct pushes to main and revamp, then hands over to Git LFS
# so large files get uploaded.
set -euo pipefail

refs=$(cat)

while read -r local_ref local_sha remote_ref remote_sha; do
  [[ -z "${local_ref:-}" ]] && continue
  if [[ "$remote_ref" == "refs/heads/main" || "$remote_ref" == "refs/heads/revamp" ]]; then
    echo "✖ Don't push to ${remote_ref#refs/heads/} directly. Push your own branch and open a pull request."
    exit 1
  fi
done <<< "$refs"

command -v git-lfs >/dev/null 2>&1 || { echo "✖ Git LFS is not installed. See README > Setup."; exit 2; }
printf '%s\n' "$refs" | git lfs pre-push "$@"
