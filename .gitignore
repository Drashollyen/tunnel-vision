# Tunnel Vision .gitignore
# Based on https://github.com/github/gitignore/blob/main/Unity.gitignore (CC0-1.0)
# If `git status` shows something from the lists below, don't commit it. Ask in the group first.

# ---------------------------------------------------------------------------
# Unity: generated folders (rebuilt automatically when you open the project)
# ---------------------------------------------------------------------------
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/
.utmp/
*.log

# Builds (CI produces these; share builds via GitHub Actions artifacts, not git)
/[Bb]uild/
/[Bb]uilds/
*.apk
*.aab
*.app
*.exe
*.unitypackage
*.unitypackage.meta
crashlytics-build.properties

# Generated IDE project files (Unity regenerates them)
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Crash reports and runtime dumps
sysinfo.txt
mono_crash.*

# Test runner scenes created during PlayMode tests
InitTestScene*.unity*
/[Aa]ssets/[Ii]nit[Tt]est[Ss]cene*.unity*

# Auto-generated caches inside Assets
/[Aa]ssets/[Ss]ceneDependencyCache*
/[Aa]ssets/Plugins/Editor/JetBrains*

# Addressables build output
/ServerData
/[Aa]ssets/StreamingAssets/aa*
/[Aa]ssets/AddressableAssetsData/link.xml*
/[Aa]ssets/Addressables_Temp*
/[Aa]ssets/AddressableAssetsData/*/*.bin*

# Blender backup files
*.blend1
*.blend1.meta

# Unity Version Control (Plastic SCM). We use Git.
.plastic/
ignore.conf

# ---------------------------------------------------------------------------
# Editors and IDEs (personal settings)
# ---------------------------------------------------------------------------
.vs/
.idea/
.vscode/
*.DotSettings.user
.gradle/
*.swp

# ---------------------------------------------------------------------------
# Operating systems
# ---------------------------------------------------------------------------
.DS_Store
._*
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# ---------------------------------------------------------------------------
# CI scratch files
# ---------------------------------------------------------------------------
.lfs-assets-id
